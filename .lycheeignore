# .lycheeignore — URLs lychee should NOT check (repo-root override)
# Overrides the shared template from .mega-linter.d/.lycheeignore.
#
# Format: one regular expression per line, matched against the extracted URL.
# Lines starting with `#` are comments.
#
# Curation principle: only ignore URLs that cannot resolve by design. A link
# that is merely slow or rate-limited belongs in lychee's retry and accept
# settings; a link that is genuinely broken must be fixed, not ignored.

# -----------------------------------------------------------------------------
# URLs assembled at runtime
# -----------------------------------------------------------------------------
# lychee extracts the literal source text, so template placeholders are never
# substituted. A shell `${VAR}` survives verbatim (or percent-encoded as
# `$%7BVAR%7D` when it follows the host), and a GitHub Actions `${{ ... }}`
# expression truncates at the `$` because `{` cannot appear in a URL. All three
# forms produce a request to an address that only exists once the job expands
# it, so the result says nothing about link health.
^https?://.*(\$\{|\$%7B|\$$)

# -----------------------------------------------------------------------------
# in-toto predicate type URIs
# -----------------------------------------------------------------------------
# `cosign attest --type=<uri>` takes a namespace identifier, not a fetchable
# document — cosign uses the URI verbatim as the statement's predicateType.
# cosign.sigstore.dev has no DNS record at all, so the check fails as a
# connection error on every run regardless of network conditions.
^https://cosign\.sigstore\.dev/attestation/

# -----------------------------------------------------------------------------
# Repo-specific exclusions
# -----------------------------------------------------------------------------
# Custom predicate type minted by .github/workflows/custom-flavor-release.yml
# for the repository-scan attestation. Same rule as above: an identifier, not a
# document. megalinter.io serves 404 for the path.
^https://megalinter\.io/attestation/

# -----------------------------------------------------------------------------
# Local and non-routable addresses
# -----------------------------------------------------------------------------
# Example URLs for dev servers, internal services and cloud metadata endpoints
# only resolve on the author's machine or inside a private network; nothing
# answers for them in the linter container, so a failure says nothing about
# link health. Each rule allows an optional port and path/query/fragment.
# loopback and unspecified hosts
^https?://(([a-z0-9-]+\.)*localhost|127(\.[0-9]{1,3}){3}|0\.0\.0\.0)(:[0-9]+)?([/?#]|$)
# IPv4 private (RFC 1918) and link-local (169.254/16, incl. cloud metadata)
^https?://(10(\.[0-9]{1,3}){3}|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2}|192\.168(\.[0-9]{1,3}){2}|169\.254(\.[0-9]{1,3}){2})(:[0-9]+)?([/?#]|$)
# IPv6 loopback/unspecified, unique-local fc00::/7, link-local fe80::/10
^https?://\[(::1?|0{1,4}(:0{1,4}){6}:0{0,3}[01]|f[cd][0-9a-f]{2}:[0-9a-f:.]*|fe[89ab][0-9a-f]:[0-9a-f:.]*)\](:[0-9]+)?([/?#]|$)
# reserved/local-only TLDs
^https?://([a-z0-9-]+\.)+(test|example|invalid|local|internal|home\.arpa)(:[0-9]+)?([/?#]|$)
